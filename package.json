{
  "name": "@teminali/core",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix studio run dev:full",
    "dev:ui": "npm --prefix studio run dev",
    "studio:install": "npm --prefix studio install",
    "studio:test": "npm --prefix studio test",
    "studio:typecheck": "npm --prefix studio run typecheck",
    "studio:build": "npm --prefix studio run build",
    "verify:all": "npm test && npm --prefix studio run verify:core",
    "agent:start": "zsh scripts/start-controlled-agent.zsh",
    "agent:start-claude": "AGENT_PROFILE=claude-sonnet zsh scripts/start-frontier-agent.zsh",
    "agent:start-opus": "AGENT_PROFILE=claude-opus zsh scripts/start-frontier-agent.zsh",
    "agent:start-enhanced": "AGENT_PROFILE=claude-groq-enhanced zsh scripts/start-frontier-agent.zsh",
    "agent:start-local": "AGENT_PROFILE=local-coder zsh scripts/start-frontier-agent.zsh",
    "ollama:tune": "zsh scripts/tune-ollama-memory.zsh",
    "claude:diagnose": "zsh scripts/diagnose-claude.zsh",
    "claude:diagnose-direct": "zsh scripts/diagnose-claude-direct.zsh",
    "claude:diagnose-opus": "zsh scripts/diagnose-claude-opus.zsh",
    "benchmark:prepare": "node scripts/prepare-sonnet-antigravity-benchmark.mjs",
    "benchmark:start-sonnet": "zsh scripts/start-sonnet-benchmark.zsh",
    "benchmark:score": "node scripts/score-sonnet-antigravity-benchmark.mjs",
    "benchmark:002:prepare": "node scripts/prepare-frontier-benchmark-002.mjs",
    "benchmark:002:clock": "node scripts/benchmark-002-clock.mjs",
    "benchmark:002:score": "node scripts/score-frontier-benchmark-002.mjs",
    "gemini:diagnose": "zsh scripts/diagnose-gemini.zsh",
    "gemini:diagnose-direct": "zsh scripts/diagnose-gemini-direct.zsh",
    "gateway:start": "node gateway/start-gateway.js",
    "test": "node --test calculator.test.js gateway/*.test.js billing/tests/*.test.mjs",
    "benchmark:003:score": "node benchmarks/website-builder-saas-launch-003/oracle/score.mjs",
    "teminali": "node bin/frontier.js",
    "frontier": "node bin/frontier.js",
    "benchmark:004": "echo Running Benchmark 004: Multi-File State Refactor",
    "benchmark:005": "echo Running Benchmark 005: Video MCP Timeline Sync",
    "benchmark:all": "echo Running Full 5-Suite Benchmark Matrix"
  },
  "bin": {
    "teminali": "./bin/frontier.js",
    "teminali-studio": "./bin/frontier.js",
    "frontier": "./bin/frontier.js",
    "frontier-code": "./bin/frontier.js"
  }
}
