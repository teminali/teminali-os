{
  "$schema": "https://opencode.ai/config.json",
  "model": "frontier-gateway/frontier-code",
  "provider": {
    "frontier-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Frontier Gateway",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:GATEWAY_ACCESS_TOKEN}"
      },
      "models": {
        "frontier-code": {
          "name": "Claude Opus 5 Controlled Escalation",
          "limit": { "context": 1000000, "output": 4096 },
          "variants": {
            "high": { "reasoningEffort": "high" }
          }
        }
      }
    }
  }
}
