{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.studio/schemas/benchmark-score-v1.json",
  "title": "Frontier controlled benchmark score artifact",
  "description": "Generated by benchmark/score.mjs. Score artifacts are append-only and reference exact source-byte hashes.",
  "type": "object",
  "required": ["schemaVersion", "scorerVersion", "benchmarkId", "artifactId", "generatedAt", "source", "artifactVerification", "status", "eligibility", "participants", "comparison", "artifactRefs"],
  "properties": {
    "schemaVersion": { "const": "frontier-benchmark-score/v1" },
    "scorerVersion": { "type": "string", "minLength": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "pattern": "^score-[a-f0-9]{20}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["manifestSha256", "resultSha256"],
      "properties": {
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resultSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifactVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "issues"],
      "properties": {
        "verified": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "enum": ["complete", "partial", "invalid"] },
    "eligibility": {
      "type": "object",
      "required": ["comparisonEligible", "reasons"],
      "properties": {
        "comparisonEligible": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "participants": { "type": "array", "minItems": 2, "maxItems": 2 },
    "comparison": {
      "type": "object",
      "required": ["status", "winnerParticipantId", "rationale"],
      "properties": {
        "status": { "enum": ["winner", "tie", "inconclusive"] },
        "winnerParticipantId": { "type": ["string", "null"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "artifactRefs": { "type": "array", "items": { "type": "string" } }
  }
}
