{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.studio/schemas/benchmark-manifest-v1.json",
  "title": "Frontier controlled benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "title", "exampleOnly", "status", "createdAt", "sealedAt", "environment", "contestants", "controls", "tasks"],
  "properties": {
    "schemaVersion": { "const": "frontier-benchmark-manifest/v1" },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "exampleOnly": { "type": "boolean" },
    "status": { "enum": ["draft", "sealed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "sealedAt": { "type": ["string", "null"], "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "operatingSystem", "repositorySnapshotSha256", "networkPolicy"],
      "properties": {
        "hardware": { "type": "string", "minLength": 1 },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "repositorySnapshotSha256": { "$ref": "#/$defs/sha256" },
        "networkPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "contestants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "model", "configuration", "configurationArtifact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "configuration": { "type": "string", "minLength": 1 },
          "configurationArtifact": { "$ref": "#/$defs/artifactRef" }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredTaskCount", "runsPerTask", "timeLimitMs", "retryLimit", "maxHumanInterventions", "minimumWinnerMarginPoints"],
      "properties": {
        "requiredTaskCount": { "type": "integer", "minimum": 1 },
        "runsPerTask": { "type": "integer", "minimum": 3 },
        "timeLimitMs": { "type": "integer", "minimum": 1 },
        "retryLimit": { "type": "integer", "minimum": 0 },
        "maxHumanInterventions": { "type": "integer", "minimum": 0 },
        "minimumWinnerMarginPoints": { "type": "number", "minimum": 0 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "weight", "promptArtifact", "fixtureArtifact", "evaluatorArtifact", "requiredArtifacts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "promptArtifact": { "$ref": "#/$defs/artifactRef" },
          "fixtureArtifact": { "$ref": "#/$defs/artifactRef" },
          "evaluatorArtifact": { "$ref": "#/$defs/artifactRef" },
          "requiredArtifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
