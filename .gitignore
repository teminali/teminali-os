.DS_Store
.env
.env.*
!.env.example
node_modules/
studio/node_modules/
dist/
studio/dist/
release/
studio/release/
coverage/
.vite/
*.log
*.tmp
outputs/
benchmark-results/

# The compiled pointer helper. Built by `npm run build:pointer` from the Swift
# source beside it; an unsigned Mach-O in git is one nobody can audit.
studio/native/macos/bin/

# Session handover notes, written by the handover skill. Working notes about
# the repository rather than part of it.
.claude/
.agent/

# The eval harness bundles the editor tool manifest here before it runs.
studio/evals/.build/

# The realtime voice pipeline (studio/realtime-voice/) is source of this repo.
# What is excluded is everything reproducible or enormous: the 2 GB virtualenv,
# the vendored wheels, the tuning experiments that produced the voice, and the
# .pre-* snapshots left beside files while they were being tuned.
studio/realtime-voice/.venv/
studio/realtime-voice/wheels/
studio/realtime-voice/experiments/
studio/realtime-voice/code/scratch/
studio/realtime-voice/**/*.pre-*
studio/realtime-voice/**/*.bak
studio/realtime-voice/**/*.claude_overengineered_bak
studio/realtime-voice/.claude/
studio/realtime-voice/.agent/
# The voice tuning artefacts: 95 MB of rendered takes and cached renders that
# produced Bella's timing. The measurements that came out of them are written
# down in code comments and LOCKED_PIPELINE_SPEC.md, which is the part worth
# versioning. The audio stays on disk, out of the history.
studio/realtime-voice/resources/bella/.cache/
studio/realtime-voice/**/*.wav
studio/realtime-voice/**/*.mp3
studio/realtime-voice/**/*.flac
