{
  "$schema": "https://opencode.ai/config.json",
  "model": "frontier-gateway/frontier-code",
  "enabled_providers": ["frontier-gateway"],
  "agent": {
    "title": { "disable": true }
  },
  "tools": {
    "glob": false
  },
  "provider": {
    "frontier-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Frontier Gateway",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "{env:GATEWAY_ACCESS_TOKEN}",
        "timeout": 660000,
        "chunkTimeout": 600000
      },
      "models": {
        "frontier-code": {
          "name": "Frontier · Local Coding Model ($0.00)",
          "limit": {
            "context": 16384,
            "output": 3072
          }
        }
      }
    }
  }
}
